# Backend API root URL (no trailing slash). API paths are appended as /api/...
# Example: https://mudhro-agency-api.azurewebsites.net
#
# Local dev: leave unset to use http://localhost:4000 on localhost only.
# Production (Azure): set VITE_API_BASE_URL in App Service Application settings
# BEFORE deploy — Vite inlines this at build time; changing it requires a redeploy.
#
# VITE_API_BASE_URL=https://mudhro-agency-api.azurewebsites.net
